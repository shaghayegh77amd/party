# PostgreSQL connection string.
# Local dev example (matches README setup instructions):
# DATABASE_URL="postgresql://wedding_app:wedding_local_dev_pw@localhost:5432/wedding_invite"
# Hosted example (Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL=

# Password required to access /admin. Keep this secret and long.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
